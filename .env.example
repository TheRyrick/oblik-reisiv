# Змінні оточення для деплою. Скопіюйте назви в налаштування хостингу:
#   Netlify: Site configuration → Environment variables
#   Vercel:  Project → Settings → Environment Variables
#   GitHub Pages: Settings → Secrets and variables → Actions → Variables
# Значення: Supabase → Project Settings → API (Data API).

# URL проєкту Supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Публічний ключ anon (або publishable, sb_publishable_...). НЕ service_role!
SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
